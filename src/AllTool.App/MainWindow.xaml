<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AllTool.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="All Tool —— 命令行软件的可视化宿主">

    <!-- 结构：顶部菜单栏；左侧是可分组的工具包/动作列表；中间是自动生成的表单；下面是实时输出。
         列表与表单都由代码按清单动态生成（见 MainWindow.xaml.cs）。 -->
    <Grid x:Name="RootGrid" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="220" />
        </Grid.RowDefinitions>

        <!-- ============ 菜单栏 ============ -->
        <MenuBar Grid.Row="0">
            <MenuBarItem Title="文件">
                <MenuFlyoutItem Text="安装工具包…" Click="OnInstallPackageClicked" />
                <MenuFlyoutItem Text="打开工具包目录" Click="OnOpenPluginsFolderClicked" />

                <MenuFlyoutItem Text="打开日志文件夹" Click="OnOpenLogFolderClicked" />

                <MenuFlyoutItem Text="清理缓存…" Click="OnClearCacheClicked" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="重新载入全部工具包" Click="OnReloadPackagesClicked" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="以管理员身份重新启动" Click="OnRestartElevatedClicked" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="退出" Click="OnExitClicked" />
            </MenuBarItem>
            <MenuBarItem Title="帮助">
                <MenuFlyoutItem Text="首页" Click="OnHomeClicked" />
                    <MenuFlyoutItem Text="关于 All Tool" Click="OnAboutClicked" />
                <MenuFlyoutItem Text="打开项目说明（AGENTS.md）" Click="OnOpenDocsClicked" />
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1" Padding="12,0,12,0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左：工具包与动作（按分组展示） ============ -->
            <Grid Grid.Column="0" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <TextBox x:Name="FilterBox" PlaceholderText="筛选工具包与动作…"
                         TextChanged="OnFilterChanged" />

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Name="PackageSectionTitle" Text="工具包" VerticalAlignment="Center"
                               Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,4,0,0" />
                    <Button x:Name="PackageGroupButton" Content="分组…" Click="OnPackageGroupClicked"
                            Padding="8,2,8,2" FontSize="12" VerticalAlignment="Center"
                            ToolTipService.ToolTip="把当前选中的工具包移到别的分组，或新建一个分组" />
                </StackPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PackageGroupsPanel" Spacing="2" />
                </ScrollViewer>

                <TextBlock x:Name="ActionSectionTitle" Grid.Row="3" Text="动作"
                           Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,6,0,0" />
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ActionGroupsPanel" Spacing="2" />
                </ScrollViewer>
            </Grid>

            <!-- ============ 中：表单、下一步、执行 ============ -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="ActionTitle" Text="请先在左侧选择工具包与动作"
                           Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />

                <ScrollViewer Grid.Row="1" MaxHeight="140" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ActionDescription" Opacity="0.75" TextWrapping="Wrap" />
                </ScrollViewer>

                <!-- 会话型工具包（例如 diskpart）：显示"当前作用于什么"，并提供清除 -->
                <StackPanel Grid.Row="2" x:Name="SessionBar" Spacing="4" Visibility="Collapsed"
                            Padding="8" CornerRadius="4" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}">
                    <TextBlock x:Name="SessionStateText" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ClearSessionButton" Content="清除会话状态" Click="OnClearSessionClicked"
                                Padding="8,2,8,2" FontSize="12" />
                        <TextBlock Text="灰显的动作表示前置条件还没满足（鼠标悬浮看原因）"
                                   Opacity="0.75" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="FormPanel" Spacing="12" />
                </ScrollViewer>

                <TextBox Grid.Row="4" x:Name="CommandLineBox" Header="将要执行的命令（只读，便于核对）"
                         IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" />

                <!-- 执行完之后按清单里的 nextSteps 呈现"下一步"按钮 -->
                <StackPanel Grid.Row="5" x:Name="NextStepsPanel" Spacing="6" Visibility="Collapsed" />

                <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="RunButton" Content="执行" Click="OnRunClicked"
                            Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                    <Button x:Name="CancelButton" Content="取消" Click="OnCancelClicked" IsEnabled="False" />
                    <Button x:Name="CopyCommandButton" Content="复制命令" Click="OnCopyCommandClicked" />

                    <Button x:Name="TerminalButton" Content="在终端中打开" Click="OnOpenTerminalClicked"

                            ToolTipService.ToolTip="把同一条命令放进真正的命令行窗口里执行（需要交互、或你想自己看输出的场合）" />
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <ProgressBar Grid.Row="7" x:Name="ProgressIndicator" Minimum="0" Maximum="100" ShowError="False" />
            </Grid>
        </Grid>

        <!-- ============ 下：实时输出 ============ -->
        <Grid Grid.Row="2" Padding="12,0,12,12" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="输出" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <Button x:Name="CopyOutputButton" Content="复制输出" Click="OnCopyOutputClicked"
                        Padding="8,2,8,2" FontSize="12" />
            </StackPanel>

            <TextBox Grid.Row="1" x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" FontFamily="Consolas"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </Grid>
    </Grid>
</Window>
