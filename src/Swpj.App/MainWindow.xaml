<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Swpj.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="swpj —— 命令行软件的可视化宿主">

    <!-- 结构尽量简单：左侧选工具包与动作，中间是自动生成的表单，下面是实时输出。
         表单控件由代码按清单动态生成（见 MainWindow.xaml.cs 的 BuildForm）。 -->
    <Grid Padding="12" RowSpacing="10" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="240" />
        </Grid.RowDefinitions>

        <!-- 左：工具包与动作 -->
        <Grid Grid.Row="0" Grid.Column="0" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>

            <TextBlock Text="工具包" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="PackageList" Grid.Row="1" SelectionMode="Single"
                      SelectionChanged="OnPackageSelectionChanged"
                      DisplayMemberPath="Display" />

            <TextBlock Grid.Row="2" Text="动作" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="ActionList" Grid.Row="3" SelectionMode="Single"
                      SelectionChanged="OnActionSelectionChanged"
                      DisplayMemberPath="Display" />
        </Grid>

        <!-- 中：表单与执行 -->
        <Grid Grid.Row="0" Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="ActionTitle" Text="请先在左侧选择工具包与动作"
                       Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />

            <TextBlock x:Name="ActionDescription" Grid.Row="1" Opacity="0.75" TextWrapping="Wrap" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="FormPanel" Spacing="12" />
            </ScrollViewer>

            <TextBox Grid.Row="3" x:Name="CommandLineBox" Header="将要执行的命令（只读，便于核对）"
                     IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
                <Button x:Name="RunButton" Content="执行" Click="OnRunClicked"
                        Style="{StaticResource AccentButtonStyle}" IsEnabled="False" />
                <Button x:Name="CancelButton" Content="取消" Click="OnCancelClicked" IsEnabled="False" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <ProgressBar Grid.Row="5" x:Name="ProgressIndicator" Minimum="0" Maximum="100" ShowError="False" />
        </Grid>

        <!-- 下：实时输出 -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="输出" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBox Grid.Row="1" x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" FontFamily="Consolas"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </Grid>
    </Grid>
</Window>
